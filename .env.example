# ─── PostgreSQL-Verbindung ───────────────────────────────────────────
# Lokal: postgres://user:password@localhost:5432/notizen
# Azure: postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/notizen

# ─── Server-Konfiguration ────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
